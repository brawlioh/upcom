# Railway Environment Variables Template
# Copy these values from your working .env file to Railway dashboard

# ===== BACKEND ENVIRONMENT VARIABLES =====
# Set these in your Railway BACKEND project

# Required API Keys
OPENAI_API_KEY=your_openai_key_here
HEYGEN_API_KEY=your_heygen_key_here
VIZARD_API_KEY=your_vizard_key_here
CREATOMATE_API_KEY=your_creatomate_key_here

# Optional Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Railway automatically sets:
# PORT=8000 (or similar)

# ===== FRONTEND ENVIRONMENT VARIABLES =====
# Set these in your Railway FRONTEND project

# API URLs (replace with your actual Railway backend URL)
NEXT_PUBLIC_API_URL=https://your-backend-name.railway.app/api
NEXT_PUBLIC_WS_URL=wss://your-backend-name.railway.app/ws

# App Configuration
NEXT_PUBLIC_APP_NAME="YouTube Reels Automation"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ===== DEPLOYMENT NOTES =====
# 1. Deploy backend first, get the Railway URL
# 2. Update NEXT_PUBLIC_API_URL and NEXT_PUBLIC_WS_URL with actual backend URL
# 3. Deploy frontend with updated environment variables
# 4. Test both services are communicating properly
