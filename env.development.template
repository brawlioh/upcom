# Development Environment Template
# Copy this to .env.development for local testing

# API Configuration - LOCAL DEVELOPMENT
NODE_ENV=development
ENVIRONMENT=development

# Local API Server Settings
API_HOST=localhost
API_PORT=8001
USE_PRODUCTION_API=false

# Frontend Settings  
NEXT_PUBLIC_API_URL=http://localhost:8001/api
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws

# Development Mode Flags
DEBUG_MODE=true
SIMULATION_MODE=false
LOG_LEVEL=debug

# API Keys (same as production but used locally)
OPENAI_API_KEY=your_openai_key_here
HEYGEN_API_KEY=your_heygen_key_here
VIZARD_API_KEY=your_vizard_key_here
CREATOMATE_API_KEY=your_creatomate_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Steam API (optional for development)
STEAM_API_KEY=your_steam_key_here

# Development Database (if different from production)
# DATABASE_URL=your_dev_database_url_here
