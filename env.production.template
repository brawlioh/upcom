# Production Environment Template  
# These settings are configured in Railway dashboard

# API Configuration - RAILWAY PRODUCTION
NODE_ENV=production
ENVIRONMENT=production

# Railway automatically provides PORT
# PORT=8001 (set by Railway)

# Production API Server Settings
USE_PRODUCTION_API=true
API_SERVER_FILE=api_server_production.py

# Frontend Settings (Railway URLs)
NEXT_PUBLIC_API_URL=https://your-railway-backend.railway.app/api
NEXT_PUBLIC_WS_URL=wss://your-railway-backend.railway.app/ws

# Production Mode Flags
DEBUG_MODE=false
SIMULATION_MODE=false
LOG_LEVEL=info

# API Keys (set in Railway environment variables)
OPENAI_API_KEY=your_production_openai_key
HEYGEN_API_KEY=your_production_heygen_key
VIZARD_API_KEY=your_production_vizard_key
CREATOMATE_API_KEY=your_production_creatomate_key
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_name
CLOUDINARY_API_KEY=your_production_cloudinary_key
CLOUDINARY_API_SECRET=your_production_cloudinary_secret

# Steam API
STEAM_API_KEY=your_production_steam_key

# Production Database
# DATABASE_URL=your_production_database_url
