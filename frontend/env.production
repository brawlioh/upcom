# Production environment variables for Railway deployment
# Copy this to .env.production when deploying

# API Configuration - will be set dynamically by Railway
NEXT_PUBLIC_API_URL=${RAILWAY_BACKEND_URL}/api
NEXT_PUBLIC_WS_URL=${RAILWAY_BACKEND_WS_URL}/ws

# App Configuration
NEXT_PUBLIC_APP_NAME="YouTube Reels Automation"
NEXT_PUBLIC_APP_VERSION="1.0.0"
